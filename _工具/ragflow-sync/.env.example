# RAGFlow 服务配置
RAGFLOW_API_URL=http://192.168.50.242
RAGFLOW_API_KEY=your_api_key_here

# 项目根目录（相对于脚本所在目录）
PROJECT_ROOT=../..

# 同步范围（逗号分隔，可以是子目录如 xlsx/export_json）
SYNC_DIRS=docs,xlsx/export_json

# 排除规则（逗号分隔的 glob 模式，匹配相对于项目根目录的路径）
# 支持 *.ext、dir/*、path/to/file 等 .gitignore 风格模式
EXCLUDE_PATTERNS=*.xlsx

# ========================================
# 多知识库配置
# ========================================
# 启用多知识库同步（true/false）
MULTI_DATASET_ENABLED=true

# 文档分类规则（按路径前缀匹配，第一个匹配的规则生效）
# 格式：规则名=目录前缀1,目录前缀2,...；多个规则用 | 分隔
# 规则名可以任意起，每个规则名对应一个 {规则名大写}_DATASET_ID 变量
# 加新知识库 = 加一条规则 + 加一个 ID 变量，无需改代码
DATASET_RULES=tech=docs/tech|planning=docs/planning

# 各知识库 ID（变量名 = 规则名大写 + _DATASET_ID）
# 缺省的库会被跳过并警告（例如策划同事只配 PLANNING_DATASET_ID 即可只同步策划库）
TECH_DATASET_ID=
PLANNING_DATASET_ID=

# 未匹配任何规则的文件兜底归入的规则名（可选）
# 不配置则未匹配文件跳过同步并警告
DEFAULT_RULE=planning

# ========================================
# 单知识库模式（MULTI_DATASET_ENABLED=false 时生效）
# ========================================
# RAGFLOW_DATASET_ID=your_dataset_id

# 可选：单库模式也按 DATASET_RULES 过滤，只同步指定规则匹配的文件（逗号分隔）
# 例：只把策划文档同步进这个库
# SYNC_ONLY_RULES=planning
